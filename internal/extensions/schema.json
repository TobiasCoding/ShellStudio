{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ShellStudio extension manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "description",
    "compatibility",
    "origin",
    "license",
    "dependencies",
    "detection",
    "installation",
    "commands",
    "profiles",
    "default_profile"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,47}$",
      "not": {
        "const": "terminal"
      }
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "compatibility": {
      "const": "shellstudio-v1"
    },
    "origin": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executable",
        "args"
      ],
      "properties": {
        "executable": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "installation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "existing",
            "artifact",
            "python-bundle",
            "builtin"
          ]
        },
        "artifacts": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url",
              "sha256"
            ],
            "properties": {
              "url": {
                "type": "string",
                "pattern": "^https://"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "member": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/profile"
      }
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]{0,47}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/profile"
      }
    },
    "default_profile": {
      "type": "string"
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "command"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,47}$"
        },
        "command": {
          "$ref": "#/$defs/profile"
        }
      }
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executable",
        "args"
      ],
      "properties": {
        "executable": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "string"
          }
        },
        "env": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  }
}
